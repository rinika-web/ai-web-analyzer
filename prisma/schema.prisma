generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  name      String
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())
  analyses  Analysis[]
}

model Analysis {
  id                 Int              @id @default(autoincrement())
  url                String
  screenshot         String?
  overallScore       Int
  seoScore           Int
  performanceScore   Int
  accessibilityScore Int
  bestPracticesScore Int
  grade              String
  health             String
  analyzedAt         DateTime         @default(now())
  createdAt          DateTime         @default(now())
  userId             Int
  aiSummary          Json?
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  issues             Issue[]
  recommendations    Recommendation[]

  @@index([userId])
}

model Issue {
  id         Int      @id @default(autoincrement())
  category   String
  severity   String
  message    String
  analysisId Int
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model Recommendation {
  id           Int      @id @default(autoincrement())
  title        String
  description  String
  score        Float?
  displayValue String?
  savingsMs    Float?
  savingsBytes Float?
  learnMore    String?
  analysisId   Int
  analysis     Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}
